# Switch AI provider: 'api' (Google AI Studio / Gemini API) or 'local' (Ollama)
PROVIDER="api"

# GEMINI_API_KEY: Required when PROVIDER=api.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Gemma 4 Cloud Model ID on Gemini API (defaults to gemma-4-26b-a4b-it or gemma-4-31b-it)
GEMMA_API_MODEL="gemma-4-26b-a4b-it"

# Ollama local settings (used when PROVIDER=local)
OLLAMA_ENDPOINT="http://localhost:11434"
OLLAMA_MODEL="gemma4:e2b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
